#!/usr/bin/env php
<?php


require_once $GLOBALS['_composer_autoload_path'] ?? 'vendor/autoload.php';

use clearice\argparser\ArgumentParser;

$parser = new ArgumentParser();

$parser->addCommand([
    'name' => 'build',
    'help' => 'Build assets for the WYF framework',
]);

$parser->addCommand([
    'name' => 'watch',
    'help' => 'Watch and rebuild assets on change',
]);

$parser->addOption([
    'short_name' => 'd',
    'name' => 'develop',
    'help' => 'Build assets in development mode',
    'default' => false,
    'command' => 'build',
]);

$parser->enableHelp(
    "WYF Command Line Tool\nBuild and watch assets for the WYF framework.",
    "",
    "wyf"
);

$options = $parser->parse();

$command = $options['__command'] ?? null;

function runWebpack(array $args = []): void
{
    $projectDir = isset($GLOBALS['_composer_bin_dir'])
        ? dirname($GLOBALS['_composer_bin_dir'], 2)
        : getcwd();
    chdir($projectDir);

    $webpackBin = $projectDir . '/node_modules/.bin/webpack';
    $bin = file_exists($webpackBin) ? escapeshellarg($webpackBin) : 'npx webpack';

    $cmd = sprintf('%s %s', $bin, implode(' ', array_map('escapeshellarg', $args)));
    passthru($cmd, $returnCode);
    exit($returnCode);
}

switch ($command) {
    case 'build':
        $mode = !empty($options['develop']) ? 'development' : 'production';
        runWebpack(['--mode', $mode]);
        break;

    case 'watch':
        runWebpack(['--watch', '--mode', 'development']);
        break;

    default:
        echo $parser->getHelpMessage();
        exit(1);
}
